{
    "manifest_version": 3,
    "name": "SignalForge AI",
    "version": "1.0.0",
    "description": "Reads live Pocket Option market data and displays AI trading signals.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs"
    ],
    "host_permissions": [
        "https://pocket-option-signal-api-production.up.railway.app/*",
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
    ],
    "background": {
        "service_worker": "src/background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://pocketoption.com/*",
                "https://*.pocketoption.com/*"
            ],
            "js": [
                "src/injected.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://pocketoption.com/*",
                "https://*.pocketoption.com/*"
            ],
            "js": [
                "src/content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/injected.js"
            ],
            "matches": [
                "https://pocketoption.com/*",
                "https://*.pocketoption.com/*"
            ]
        }
    ],
    "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "SignalForge AI",
    "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
},
"icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
}
}