{
  "manifest_version": 3,
  "name": "Pocket Option AI Signals",
  "version": "1.0.0",
  "description": "Reads live Pocket Option market data and displays AI trading signals.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://pocket-option-signal-api-production.up.railway.app/*",
    "https://pocketoption.com/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "js": [
        "src/injected.js-loader.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ],
      "js": [
        "src/content.js-loader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected.js"
      ],
      "matches": [
        "https://pocketoption.com/*",
        "https://*.pocketoption.com/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "**/*",
        "*"
      ],
      "use_dynamic_url": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Pocket Option AI"
  },
  "externally_connectable": {
    "matches": [
      "https://pocketoption.com/*",
      "https://*.pocketoption.com/*"
    ]
  }
}
