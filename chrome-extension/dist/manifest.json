{
  "manifest_version": 3,
  "name": "Pocket Option AI Signals",
  "version": "1.0.0",
  "description": "Reads live Pocket Option market data and displays AI trading signals.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.js-DVbd9BT8.js"
      ],
      "matches": [
        "https://*.pocketoption.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "assets/content-YaZSwduM.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.pocketoption.com/*"
      ],
      "resources": [
        "src/injected.js",
        "assets/content.js-DVbd9BT8.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Pocket Option AI"
  }
}
