{
  "manifest_version": 3,
  "name": "Pocket Option AI Signals",
  "version": "1.0.0",
  "description": "Reads live Pocket Option market data and displays AI trading signals.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://pocket-option-signal-api-production.up.railway.app/*",
    "https://*.pocketoption.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/injected.js-DcbogQpk.js"
      ],
      "matches": [
        "https://*.pocketoption.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/content.js-bmIV8U8I.js"
      ],
      "matches": [
        "https://*.pocketoption.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "assets/content-x1XGuNl0.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.pocketoption.com/*"
      ],
      "resources": [
        "src/injected.js",
        "assets/injected.js-DcbogQpk.js",
        "assets/content.js-bmIV8U8I.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Pocket Option AI"
  }
}
